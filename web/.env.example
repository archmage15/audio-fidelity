# ---- deployment: read by docker compose (api, redis) AND the host worker (systemd) ----
RELEASE=latest
ENGINE_ROOT=/www/wwwroot/projectRepo/Cor-Pron/audio-fidelity-linux
DATA_ROOT=/srv/audio-demo/data
HTTP_PORT=8896
APP_UID=1001
APP_GID=1001
REDIS_PORT=6380
# Change the cache namespace (v1 → v2) whenever transcoding rules or models change.
CACHE_NAMESPACE=v1
REDIS_PASSWORD=change-me-to-a-long-random-string

# ---- website ----
PUBLIC_ORIGIN=https://audio-fidelity.xinghexingsui.com
COOKIE_SECURE=true
SESSION_DAYS=30
MAX_UPLOAD_BYTES=20971520
MIN_AUDIO_SECONDS=2
MAX_AUDIO_SECONDS=60
MAX_REFERENCE_SECONDS=60
MAX_ACTIVE_PER_USER=2
MAX_ACTIVE_GLOBAL=20
ENGINE_TIMEOUT_SECONDS=840
RQ_JOB_TIMEOUT=900
MIN_FREE_BYTES=2147483648
RETENTION_DAYS=7
IDLE_UPLOAD_HOURS=24
HF_OFFLINE=true
# Engine: server = persistent process (systemd audio-fidelity-engine) keeps models loaded;
# oneshot = start a fresh engine process per job (old behaviour, fallback).
ENGINE_MODE=server
# The persistent engine restarts itself after a job when its RSS exceeds this (MB).
ENGINE_SERVER_MAX_RSS_MB=3200
# Transcription provider used until an admin switches it on the web page: xunfei | tingwu
ASR_PROVIDER=xunfei
# 通义听悟 config (default: $ENGINE_ROOT/听悟配置.json; see deploy/听悟配置.example.json)
# TINGWU_CONFIG=/www/wwwroot/projectRepo/Cor-Pron/audio-fidelity-linux/听悟配置.json
# Optional: lower the engine's numeric thread count (default = CPUs selected by the engine, max 3).
# AUDIO_TEST_CPU_THREADS=2
